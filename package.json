{
  "name": "SPICE GUI",
  "version": "0.0.9",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "build:e2e": "pnpm prebuild && node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build --mode e2e",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "svelte-kit sync && vitest run",
    "e2e:build": "node scripts/e2e-build.mjs",
    "e2e": "wdio run ./e2e/wdio.conf.js",
    "e2e:ci": "pnpm e2e:build && pnpm e2e",
    "tauri": "tauri",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage cookie globalVariable baseLocale && node scripts/clean-inlang-gitignore.mjs",
    "predev": "node scripts/sync-logo.mjs && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage cookie globalVariable baseLocale && node scripts/clean-inlang-gitignore.mjs && node scripts/patch-android-landscape.mjs",
    "prebuild": "node scripts/sync-logo.mjs && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage cookie globalVariable baseLocale && node scripts/clean-inlang-gitignore.mjs && node scripts/patch-android-landscape.mjs",
    "sync:bioart": "node scripts/sync-bioart.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-svelte": "^1.0.1",
    "mermaid": "^12.3.0",
    "molstar": "^5.11.0",
    "pptxgenjs": "^4.0.1",
    "svelte-multistyle-ui": "0.0.14-alpha",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "jsdom": "^30.1.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "webdriverio": "9.32.0"
  }
}
